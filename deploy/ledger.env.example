# /etc/ledger/ledger.env — owned root:ledger, mode 0640 (contains the DB password).
# Read by systemd (EnvironmentFile) and by the ledger-user/ledger-backup tools.
# Keep values unquoted and free of spaces.

# Written by setup-db.sh. The application role owns nothing in the database.
DATABASE_URL=postgres://ledger_app:CHANGE_ME@127.0.0.1:5432/ledger?sslmode=disable

# Listen address. Use 127.0.0.1:8080 if a reverse proxy runs in the container.
HTTP_ADDR=:8080

# CSV import/export directory (TrueNAS bind mount).
CSV_DIR=/app/csv_data

# Session cookie Secure flag: auto (Secure when served over HTTPS or behind a
# proxy sending X-Forwarded-Proto: https), true, or false.
COOKIE_SECURE=auto

# Small footprint: few DB connections and a soft Go heap limit.
DB_MAX_CONNS=4
GOMEMLIMIT=160MiB

# Nightly backups (ledger-backup.timer).
BACKUP_DIR=/app/csv_data/backups
BACKUP_KEEP_DAYS=30
